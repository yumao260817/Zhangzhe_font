# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Node
webui/node_modules/

# 构建产物（FastAPI 托管用，改动 vue 后 npm.cmd run build 重建；仅保留目录）
webui/dist/*
!webui/dist/.gitkeep

# 数据库（含用户/会话/审核数据，勿提交，仅保留目录）
queue/*
!queue/.gitkeep
*.db
*.sqlite3

# 本地配置（含敏感项），模板见 configs/default.example.yaml
configs/default.yaml
.env

# 拼字工作台运行期数据（用户上传部件/候选，仅保留目录结构）
data/puzzle/**
!data/puzzle/**/
!data/puzzle/.gitkeep
!data/puzzle/**/.gitkeep

# data 目录下全部图片不入库（手写素材/标准字形/部件等）
data/**/*.png
data/**/*.jpg
data/**/*.jpeg
data/**/*.gif
data/**/*.webp
data/**/*.svg
data/**/*.bmp
data/**/*.tif
data/**/*.tiff
data/**/*.ico

# 其他工具记忆
.workbuddy/

# AI Agent 相关文件（一律不提交）
AGENTS.md
.opencode/
.claude/
.cursor/
.copilot/
agents/
*.agent.md

# 导出产物（fonts 随仓库上传；reports 含联系人生成图，不入库，仅保留目录）
output/reports/*
!output/reports/.gitkeep

# 失效/大体积资产（保留在磁盘，不入库，仅保留目录）
others/*
!others/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
models/
*.pt
*.pth

# 系统
.DS_Store
Thumbs.db
